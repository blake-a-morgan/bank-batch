//RPTSORT  JOB (ACCT),CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//STEP10   EXEC PGM=SORT
//SYSOUT   DD   SYSOUT=*
//SORTIN   DD   DSN=&SYSUID..BANK.CUSTMAST,DISP=SHR
//RPTOUT   DD   SYSOUT=*
//SYSIN    DD   *
  RECORD TYPE=F,LENGTH=200
  SORT FIELDS=(110,1,CH,A,1,12,CH,A)
  OUTFIL FNAMES=RPTOUT,
  HEADER2=(1:C'RUN DATE: ',
  DATE=(4MD-),
  34:C'BANK BATCH - CUSTOMER BALANCE REPORT',
  86:C'PAGE:',
  PAGE=(EDIT=(IIIIT)),
  /,/,
  1:C'ACCOUNT',
  16:C'NAME',
  49:C'ST',
  60:C'BALANCE',
  70:C'CREDIT LIMIT',
  87:C'LAST ACT',
  /,
  1:12C'-',
  16:30C'-',
  49:2C'-',
  54:13C'-',
  70:12C'-',
  85:10C'-'),
  BUILD=(1,12,3X,
  13,30,3X,
  93,2,3X,
  100,5,PD,EDIT=(I,III,IIT.TTS),SIGNS=(,,,-),3X,
  105,5,PD,EDIT=(I,III,IIT.TT),3X,
  119,4,C'-',123,2,C'-',125,2,132:X)
